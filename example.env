TBANK_TOKEN=t....
WIFI_SSID=My_Home_SSID
WIFI_PASSWORD=
# Chart style: "candles" (default) or "line"
CHART_TYPE=candles

# Candle bucket size for the chart: "minute" (default), "hour", "day", or
# "week". The displayed lookback window is APP_CANDLES_MAX_POINTS (see
# src/app_config.h, default 24) times this bucket size, e.g. "hour" shows
# the last 24 hours.
# CANDLE_INTERVAL=minute

# Which MOEX instrument to track. Ticker is resolved to a figi at startup via
# InstrumentsService/FindInstrument (first API-tradable match wins) and is
# also used as the on-screen title. Defaults to "SiU6" (MOEX USD/RUB
# futures) if unset.
# INSTRUMENT_TICKER=SiU6